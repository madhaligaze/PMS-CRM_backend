# Скопируйте в .env для локальной разработки (pnpm dev).
# Переменные для Railway и прода - в README.md, раздел «Railway».
NODE_ENV=development
PORT=4000
# На Railway - "::": внутренняя сеть проекта может быть только IPv6.
HOST=0.0.0.0
LOG_LEVEL=info

# База из compose.yaml (docker compose up -d db)
DATABASE_URL=postgres://bizdin:bizdin@localhost:5433/bizdin
MIGRATE_ON_START=true

# Не короче 32 символов. На проде - свой, случайный: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-in-production-0000

# Адрес, по которому браузер видит API. Веб проксирует /api на этот сервис,
# поэтому на проде это адрес веба: https://<домен веба>.
CORS_ORIGINS=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
# На проде (HTTPS) - true: cookie обновления сессии уходит только по HTTPS.
COOKIE_SECURE=false

# Сканы документов и фото. На Railway - /data/files на подключённом томе /data.
FILES_DIR=.data/files

# ТЗ требует второй фактор для управляющего и бухгалтера. Для демо можно
# выключить, чтобы войти без приложения-аутентификатора. На проде - true.
REQUIRE_TOTP_FOR_PRIVILEGED=false
