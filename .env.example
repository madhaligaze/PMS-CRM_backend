# Скопируйте в .env для локальной разработки (pnpm dev).
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# База из compose.yaml (docker compose up -d db)
DATABASE_URL=postgres://bizdin:bizdin@localhost:5433/bizdin
MIGRATE_ON_START=true

# Не короче 32 символов. На проде - свой, случайный: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-in-production-0000

# Откуда браузер может звать API (через запятую)
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
PUBLIC_API_URL=http://localhost:4000
FILES_DIR=.data/files

# ТЗ требует второй фактор для управляющего и бухгалтера. Для демо можно
# выключить, чтобы войти без приложения-аутентификатора. На проде - true.
REQUIRE_TOTP_FOR_PRIVILEGED=false
